{
  "name": "golf-stats",
  "version": "1.0.0",
  "description": "Personal golf statistics dashboard with advanced analytics and visualizations using GHIN API",
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-data.js",
    "build": "npm run fetch-data && tsc && node copy-files.js",
    "build:skip-fetch": "tsc && node copy-files.js",
    "dev": "tsc --watch",
    "serve": "npx http-server dist -p 8080 -o",
    "predeploy": "npm run build:skip-fetch",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "golf",
    "statistics",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ghin": "^0.7.0"
  }
}
